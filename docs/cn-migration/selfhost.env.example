# 境内自托管（方案 A：阿里云 ECS + docker compose）环境变量参考，见 docs/CN_MIGRATION.md 第 4 节。
# 只列出与本登记系统相关、需要决定或改动的项。变量名以所固定版本的 Supabase 官方 docker/.env.example 为准，
# 版本升级时逐项核对。真实取值只保存在服务器 /opt/registry-supabase/.env（权限 600，属主 root），
# 不提交到仓库、不发到聊天或邮件。
#
# 生成 JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY：见手册 4.4 节的本地 Python 脚本（不使用任何在线生成器）。

############ 数据库 ############
POSTGRES_PASSWORD=<随机 32 位以上；同时是 postgres、supabase_admin 等内部角色的密码>
POSTGRES_HOST=db
POSTGRES_DB=postgres            # 发布核验要求数据库名为 postgres，不要改
POSTGRES_PORT=5432              # 只在 ECS 内部/专有网络可达；安全组不得对公网开放

############ 密钥（只在服务器上） ############
JWT_SECRET=<随机 40 位以上>
ANON_KEY=<用 JWT_SECRET 签发，role=anon；写入服务器 config.js>
SERVICE_ROLE_KEY=<用 JWT_SECRET 签发，role=service_role；只用于运维脚本，绝不下发到浏览器>
DASHBOARD_USERNAME=<管理界面账号；建议不部署管理界面>
DASHBOARD_PASSWORD=<随机>

############ 网关 ############
KONG_HTTP_PORT=8000             # 只绑定本机/内网，由 Nginx 以 HTTPS 对外
KONG_HTTPS_PORT=8443            # 不对外开放

############ 接口（PostgREST） ############
# 只暴露 public。不要加入 registry_private（冻结数据版本正文等私有数据）。
PGRST_DB_SCHEMAS=public

############ 认证（GoTrue） ############
SITE_URL=https://kidneysphereregistry.cn
# 允许的回跳地址：注册确认、找回密码都回到 /auth-callback?returnTo=...（login.html、signup.html、staff.js）。
# 先抄录旧 Supabase 控制台 Authentication → URL Configuration 中的现有列表，再按需精简。
ADDITIONAL_REDIRECT_URLS=https://kidneysphereregistry.cn/**
API_EXTERNAL_URL=https://api.kidneysphereregistry.cn
JWT_EXPIRY=3600
DISABLE_SIGNUP=false            # 站点保留 /signup 自助注册
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false  # 注册需邮件确认，与旧环境一致（以旧控制台设置为准）
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

############ 邮件（境内 SMTP） ############
# 例如阿里云邮件推送（DirectMail）或企业邮箱的 SMTP。发信域名需配置 SPF/DKIM/DMARC。
SMTP_ADMIN_EMAIL=noreply@mail.kidneysphereregistry.cn
SMTP_HOST=<境内 SMTP 主机>
SMTP_PORT=465
SMTP_USER=<SMTP 账号>
SMTP_PASS=<SMTP 密码>
SMTP_SENDER_NAME=肾域·科研

############ 对外地址 ############
SUPABASE_PUBLIC_URL=https://api.kidneysphereregistry.cn

############ 存储（Storage，写在 docker-compose.yml 的 storage 服务中） ############
# STORAGE_BACKEND=file
# FILE_STORAGE_BACKEND_PATH=/var/lib/storage      # 挂载到数据盘 /data/registry-storage
# FILE_SIZE_LIMIT=10485760                        # 与 payment-proofs 桶 10MB 上限一致
# ENABLE_IMAGE_TRANSFORMATION=false               # 不部署 imgproxy
# TENANT_ID / REGION / GLOBAL_S3_BUCKET 保持官方示例的占位值
